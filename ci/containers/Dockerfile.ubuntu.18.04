# ubuntu:18.04 as published on 2023-05-30, the base of the published image. Pinned by
# digest so the base cannot change without a change here.
FROM ubuntu:18.04@sha256:152dc042452c496007f07ca9127571cb9c29697f42acbfad72324b2bb2e43c98
ENV DEBIAN_FRONTEND=noninteractive
# Used by entrypoint.sh to keep caches and build dirs separate per image.
ENV YACOIN_BUILD_IMAGE=ubuntu.18.04

RUN apt-get update && \
    apt install -y build-essential libtool \
    autotools-dev automake pkg-config bsdmainutils bison \
    curl git ca-certificates \
    python3 g++ gperf zip unzip \
    qtbase5-dev qttools5-dev-tools qttools5-dev \
    g++-multilib python3-setuptools
    
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

RUN mkdir -p /src

WORKDIR "/src"

ENTRYPOINT ["/entrypoint.sh"]
