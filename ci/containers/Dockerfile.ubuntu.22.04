# ubuntu:22.04 as published on 2026-10-02, the base of the published image. Pinned by
# digest so the base cannot change without a change here.
FROM ubuntu:22.04@sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956

ENV DEBIAN_FRONTEND=noninteractive
# Used by entrypoint.sh to keep caches and build dirs separate per image.
ENV YACOIN_BUILD_IMAGE=ubuntu.22.04

RUN apt-get update && \
    apt install -y build-essential libtool \
    autotools-dev automake pkg-config bsdmainutils bison \
    curl git ca-certificates \
    python3 g++ gperf zip unzip \
    qtbase5-dev qttools5-dev-tools qttools5-dev \
    g++-multilib python3-setuptools \
    libcapture-tiny-perl libdatetime-perl libdevel-stacktrace-perl libjson-xs-perl \
    libtimedate-perl

# lcov 2.6 for the coverage modes (Ubuntu 22.04 ships 1.14; the coverage
# targets need 2.6 or newer, see configure.ac), the Perl modules above are its
# dependencies. From the release tarball, checked against its SHA-256 (the
# digest GitHub lists for the release asset). "make install" copies the Perl
# scripts, the library and the man pages that come prebuilt in the tarball:
# "-o doc" keeps make from rebuilding the man pages (that needs Sphinx), and
# LCOV_NO_XS leaves out the optional C++ extension, so nothing is compiled.
RUN cd /tmp && \
    curl -fsSLO https://github.com/linux-test-project/lcov/releases/download/v2.6/lcov-2.6.tar.gz && \
    echo "67a45db99b8ef0260c3fac9a2e3749fd8fa350a15e235dd3c29b356d97755c75  lcov-2.6.tar.gz" | sha256sum -c && \
    tar xzf lcov-2.6.tar.gz && \
    make -C lcov-2.6 -o doc LCOV_NO_XS=1 install PREFIX=/usr/local && \
    rm -rf lcov-2.6 lcov-2.6.tar.gz && \
    lcov --version

COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

RUN mkdir -p /src

WORKDIR "/src"

ENTRYPOINT ["/entrypoint.sh"]
