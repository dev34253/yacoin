# ubuntu:22.04 as published on 2026-10-02, the base of the published image. Pinned by
# digest so the base cannot change without a change here.
FROM ubuntu:22.04@sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956

ENV DEBIAN_FRONTEND=noninteractive
# Used by entrypoint.sh to keep caches and build dirs separate per image.
ENV YACOIN_BUILD_IMAGE=ubuntu.22.04

RUN apt-get update && \
    apt install -y build-essential libtool \
    autotools-dev automake pkg-config bsdmainutils bison \
    curl git ca-certificates \
    python3 g++ gperf zip unzip \
    qtbase5-dev qttools5-dev-tools qttools5-dev \
    g++-multilib python3-setuptools \
    libcapture-tiny-perl libdatetime-perl libjson-xs-perl libtimedate-perl

# lcov 2.5 for the coverage modes (Ubuntu 22.04 ships 1.14; the coverage
# targets need 2.5 or newer, see configure.ac), the Perl modules above are its
# dependencies. From the release tarball, checked against its SHA-256 (the
# digest GitHub lists for the release asset). lcov is Perl, so nothing is
# compiled: "make install" copies the scripts, the library and the man pages
# that come prebuilt in the tarball ("-o doc_finished" keeps make from
# rebuilding the man pages, which would need Sphinx).
RUN cd /tmp && \
    curl -fsSLO https://github.com/linux-test-project/lcov/releases/download/v2.5/lcov-2.5.tar.gz && \
    echo "7e5e5a154bd5f3557659c328cab376764e7abd238bb403c424472c296b175126  lcov-2.5.tar.gz" | sha256sum -c && \
    tar xzf lcov-2.5.tar.gz && \
    make -C lcov-2.5 -o doc_finished install PREFIX=/usr/local && \
    rm -rf lcov-2.5 lcov-2.5.tar.gz && \
    lcov --version

COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

RUN mkdir -p /src

WORKDIR "/src"

ENTRYPOINT ["/entrypoint.sh"]
