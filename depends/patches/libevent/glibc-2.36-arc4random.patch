libevent: build with glibc >= 2.36 (arc4random without arc4random_addrandom)

glibc 2.36 added arc4random/arc4random_buf but not the BSD-only
arc4random_addrandom. Only call it when it exists, as upstream libevent
does since 2.1.12.

--- a/configure.ac
+++ b/configure.ac
@@ -342,6 +342,7 @@
   accept4 \
   arc4random \
   arc4random_buf \
+  arc4random_addrandom \
   eventfd \
   epoll_create1 \
   fcntl \
--- a/evutil_rand.c
+++ b/evutil_rand.c
@@ -195,8 +195,15 @@
 void
 evutil_secure_rng_add_bytes(const char *buf, size_t n)
 {
+#if defined(EVENT__HAVE_ARC4RANDOM_ADDRANDOM) || !defined(EVENT__HAVE_ARC4RANDOM)
 	arc4random_addrandom((unsigned char*)buf,
 	    n>(size_t)INT_MAX ? INT_MAX : (int)n);
+#else
+	/* glibc >= 2.36 provides arc4random() but not arc4random_addrandom();
+	 * its generator is seeded from getrandom() and needs no extra entropy. */
+	(void)buf;
+	(void)n;
+#endif
 }
 
 void
